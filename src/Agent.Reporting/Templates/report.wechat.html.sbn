<section style="font-family:-apple-system,'Microsoft YaHei',sans-serif;color:#1a1a1a;max-width:700px;margin:0 auto;line-height:1.7;font-size:15px;">
  <h1 style="font-size:20px;margin:0 0 4px;">股票追踪周报</h1>
  <p style="color:#888;font-size:13px;margin:0 0 14px;">{{ DateText }} · 周五收盘后自动生成</p>

  <p style="font-size:16px;font-weight:600;border-left:4px solid #888;padding-left:8px;margin:16px 0 6px;">组合概览</p>
  <p style="margin:0 0 4px;">持仓 <strong>{{ Summary.HoldingCount }}</strong> 只 · 可击球 <strong style="color:#c0392b;">{{ Summary.BuySignalCount }}</strong> · 到卖点 <strong style="color:#1e8449;">{{ Summary.SellSignalCount }}</strong></p>
  <p style="margin:0 0 4px;">组合总持仓市值：<strong>{{ Summary.TotalHoldingValueCny | math.round 0 }}</strong> 元人民币</p>
  <p style="margin:0 0 8px;">年度收益（年内）：<strong style="color:{{ if Summary.YtdProfitCny > 0 }}#c0392b{{ else if Summary.YtdProfitCny < 0 }}#1e8449{{ else }}#333{{ end }};">{{ Summary.YtdProfitCny | math.round 0 }}</strong> 元人民币{{ if Summary.YtdReturnPercent }}（<strong style="color:{{ if Summary.YtdReturnPercent > 0 }}#c0392b{{ else }}#1e8449{{ end }};">{{ Summary.YtdReturnPercent | math.round 2 }}%</strong>）{{ end }}</p>

  {{~ if Buyable.size > 0 ~}}
  <p style="font-size:16px;font-weight:600;border-left:4px solid #e0483d;padding-left:8px;margin:16px 0 6px;">🔴 可以击球</p>
  <div style="background:#fdeceb;border:1px solid #e0483d;border-radius:8px;padding:8px 12px;">
    {{~ for s in Buyable ~}}
    <p style="margin:2px 0;">{{ s.Quote.Name }}（{{ s.Quote.Code }}）：当前市值 {{ s.Holding.TotalMarketCapCnyYi | math.round 0 }} 亿 &lt; 理想买点 {{ s.Holding.IdealBuyYi | math.round 0 }} 亿</p>
    {{~ end ~}}
  </div>
  {{~ end ~}}

  {{~ if RiskHits.size > 0 ~}}
  <p style="font-size:16px;font-weight:600;border-left:4px solid #c0392b;padding-left:8px;margin:16px 0 6px;">🚨 风险提示</p>
  <div style="background:#fff0f0;border:1px solid #e8a0a0;border-radius:8px;padding:8px 12px;">
    {{~ for h in RiskHits ~}}
    <p style="margin:2px 0;"><span style="background:#eee;border-radius:4px;padding:0 6px;font-size:12px;">{{ h.MatchedKeyword }}</span> {{ h.StockName }}（{{ h.Code }}）：{{ h.Announcement.Title }}</p>
    {{~ end ~}}
  </div>
  {{~ end ~}}

  {{~ for g in Groups ~}}
  <p style="font-size:16px;font-weight:600;border-left:4px solid #888;padding-left:8px;margin:18px 0 6px;">{{ g.Name }}</p>
  {{~ group_has_ann = false ~}}
  {{~ for s in g.Stocks ~}}{{~ if s.Announcements.size > 0 ~}}{{~ group_has_ann = true ~}}{{~ end ~}}{{~ end ~}}
  {{~ for s in g.Stocks ~}}
  {{~ hd = s.Holding ~}}
  <section style="border:1px solid {{ if hd.CanBuy }}#e0483d{{ else }}#e5e5e5{{ end }};border-radius:10px;padding:12px 14px;margin:8px 0;">
    <p style="margin:0;font-size:16px;font-weight:600;">{{ s.Quote.Name }} <span style="color:#888;font-size:12px;font-weight:400;">{{ s.Quote.Code }}</span> · {{ hd.CurrencySymbol }}{{ s.Quote.Price }}</p>
    <p style="margin:6px 0 0;font-size:14px;color:#333;">当前市值 {{ if hd.TotalMarketCapCnyYi }}{{ hd.TotalMarketCapCnyYi | math.round 0 }} 亿{{ else }}—{{ end }} ｜ 理想买点 {{ if hd.IdealBuyYi }}{{ hd.IdealBuyYi | math.round 0 }} 亿{{ else }}—{{ end }} ｜ 卖点 {{ if hd.SellYi }}{{ hd.SellYi | math.round 0 }} 亿{{ else }}—{{ end }} ｜ 年内 {{ if hd.YtdReturnPercent }}{{ hd.YtdReturnPercent | math.round 2 }}%{{ else }}—{{ end }}</p>
    {{~ if hd.IsHolding ~}}
    <p style="margin:2px 0 0;font-size:14px;color:#333;">持股 {{ hd.Shares }} ｜ 成本 {{ hd.CurrencySymbol }}{{ hd.CostPrice }} ｜ 持仓市值 ¥{{ hd.HoldingValueCny | math.round 0 }} ｜ 比例 {{ if hd.HoldingRatioPercent }}{{ hd.HoldingRatioPercent | math.round 1 }}%{{ else }}—{{ end }}</p>
    {{~ end ~}}
    {{~ if hd.CanBuy || hd.ShouldSell ~}}
    <p style="margin:6px 0 0;">
      {{~ if hd.CanBuy ~}}<span style="background:#fdeceb;color:#c0392b;border-radius:999px;padding:2px 10px;font-size:13px;font-weight:600;">🔴 可以击球</span>{{~ end ~}}
      {{~ if hd.ShouldSell ~}}<span style="background:#eaf5ee;color:#1e8449;border-radius:999px;padding:2px 10px;font-size:13px;font-weight:600;">可考虑卖出</span>{{~ end ~}}
    </p>
    {{~ end ~}}
    {{~ if s.Financials && s.Financials.Snapshot ~}}
    {{~ fs = s.Financials.Snapshot ~}}
    <p style="margin:6px 0 0;font-size:13px;color:#555;background:#f4f6f8;border-radius:6px;padding:6px 8px;">📊 {{ fs.PeriodLabel }}：营收 {{ fs.RevenueInYi | math.round 1 }} 亿，净利 {{ fs.NetProfitInYi | math.round 1 }} 亿</p>
    {{~ end ~}}
    {{~ if s.Announcements.size > 0 ~}}
    {{~ for a in s.Announcements ~}}
    <p style="margin:3px 0 0;font-size:13px;color:#555;">· {{ a.DateText }} [{{ a.Type }}] {{ a.Title }}</p>
    {{~ end ~}}
    {{~ end ~}}
  </section>
  {{~ end ~}}
  {{~ if !group_has_ann ~}}
  <p style="color:#aaa;font-size:13px;margin:4px 0 8px;">本周无新增重要公告</p>
  {{~ end ~}}
  {{~ end ~}}

  <p style="color:#888;font-size:12px;margin-top:18px;">汇率 1 HKD = {{ HkdToCny | math.round 4 }} CNY（{{ if IsLiveRate }}实时{{ else }}回退静态{{ end }}）；港股金额已折人民币，每股价格为原币种。本报告由规则自动生成，仅供个人跟踪参考，不构成任何投资建议。</p>
</section>
