<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>股票追踪周报 {{ DateText }}</title>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; }
  body { font-family: -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif; margin: 0 auto; max-width: 720px; padding: 1rem; line-height: 1.5; color: #1a1a1a; background: #fafafa; }
  h1 { font-size: 1.35rem; margin: 0 0 0.25rem; }
  h2 { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; border-left: 4px solid #888; padding-left: 0.5rem; }
  .meta { color: #666; font-size: 0.85rem; margin-bottom: 1rem; }
  .tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
  .tile { background: #fff; border: 1px solid #e5e5e5; border-radius: 8px; padding: 0.6rem 0.8rem; }
  .tile .label { color: #666; font-size: 0.78rem; }
  .tile .value { font-size: 1.25rem; font-weight: 600; }
  .card { background: #fff; border: 1px solid #e5e5e5; border-radius: 10px; padding: 0.85rem 1rem; margin: 0.6rem 0; }
  .card.hit { border-color: #e0483d; box-shadow: 0 0 0 1px #e0483d33; }
  .card .head { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; }
  .card .nm { font-size: 1.05rem; font-weight: 600; }
  .card .cd { color: #888; font-size: 0.8rem; font-variant-numeric: tabular-nums; }
  .card .px { font-size: 1.05rem; font-weight: 600; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.15rem 0.75rem; margin-top: 0.5rem; font-size: 0.88rem; }
  .grid .k { color: #666; }
  .grid .v { text-align: right; font-variant-numeric: tabular-nums; }
  .badge { display: inline-block; border-radius: 999px; padding: 0.05rem 0.55rem; font-size: 0.78rem; font-weight: 600; }
  .badge.buy { background: #fdeceb; color: #c0392b; }
  .badge.sell { background: #eaf5ee; color: #1e8449; }
  .badges { margin-top: 0.5rem; display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .up { color: #c0392b; } .down { color: #27ae60; } .muted { color: #aaa; }
  .risk { background: #fff0f0; border: 1px solid #e8a0a0; border-radius: 8px; padding: 0.5rem 0.9rem; }
  .risk li { margin: 0.2rem 0; }
  .buypanel { background: #fdeceb; border: 1px solid #e0483d; border-radius: 8px; padding: 0.5rem 0.9rem; }
  .tag { display: inline-block; background: #eee; color: #444; border-radius: 4px; padding: 0 0.4rem; font-size: 0.72rem; }
  .ann { margin: 0.4rem 0 0; padding-left: 1.1rem; }
  .ann li { margin: 0.15rem 0; font-size: 0.85rem; }
  .ann-date { color: #888; font-variant-numeric: tabular-nums; }
  .ann-none { color: #aaa; font-size: 0.85rem; margin: 0.3rem 0 0.6rem; }
  .fin { margin-top: 0.5rem; font-size: 0.85rem; color: #444; background: #f4f6f8; border-radius: 6px; padding: 0.4rem 0.6rem; }
  a { color: #2a6; text-decoration: none; }
  .foot { color: #888; font-size: 0.78rem; margin-top: 1.5rem; border-top: 1px solid #e5e5e5; padding-top: 0.75rem; }
  @media (prefers-color-scheme: dark) {
    body { color: #e5e5e5; background: #161616; }
    .tile, .card, .fin { background: #232323; border-color: #383838; }
    .fin { background: #1e1e1e; }
    .risk { background: #2e2020; border-color: #6a3a3a; }
    .buypanel { background: #2e1e1c; border-color: #e0483d; }
    .tag { background: #333; color: #ccc; }
    .up { color: #ff6b6b; } .down { color: #51cf66; }
    a { color: #6c9; }
  }
</style>
</head>
<body>
  <h1>股票追踪周报</h1>
  <div class="meta">{{ DateText }} · 周五收盘后自动生成</div>

  <h2>组合概览</h2>
  <div class="tiles">
    <div class="tile"><div class="label">持仓股票</div><div class="value">{{ Summary.HoldingCount }}</div></div>
    <div class="tile"><div class="label">可击球</div><div class="value up">{{ Summary.BuySignalCount }}</div></div>
    <div class="tile"><div class="label">到卖点</div><div class="value down">{{ Summary.SellSignalCount }}</div></div>
    <div class="tile"><div class="label">组合总持仓市值(元)</div><div class="value">{{ Summary.TotalHoldingValueCny | math.round 0 | math.format "N0" }}</div></div>
  </div>

  {{~ if Buyable.size > 0 ~}}
  <h2>🔴 可以击球</h2>
  <ul class="buypanel">
    {{~ for s in Buyable ~}}
    <li><strong>{{ s.Quote.Name }}</strong>（{{ s.Quote.Code }}）：当前市值 {{ s.Holding.TotalMarketCapCnyYi | math.round 0 }} 亿 &lt; 理想买点 {{ s.Holding.IdealBuyYi | math.round 0 }} 亿</li>
    {{~ end ~}}
  </ul>
  {{~ end ~}}

  {{~ if RiskHits.size > 0 ~}}
  <h2>🚨 风险提示</h2>
  <ul class="risk">
    {{~ for h in RiskHits ~}}
    <li><span class="tag">{{ h.MatchedKeyword }}</span> <strong>{{ h.StockName }}</strong>（{{ h.Code }}）：<a href="{{ h.Announcement.Url }}">{{ h.Announcement.Title }}</a></li>
    {{~ end ~}}
  </ul>
  {{~ end ~}}

  {{~ for g in Groups ~}}
  <h2>{{ g.Name }}</h2>
  {{~ group_has_ann = false ~}}
  {{~ for s in g.Stocks ~}}{{~ if s.Announcements.size > 0 ~}}{{~ group_has_ann = true ~}}{{~ end ~}}{{~ end ~}}
  {{~ for s in g.Stocks ~}}
  {{~ hd = s.Holding ~}}
  <div class="card {{ if hd.CanBuy }}hit{{ end }}">
    <div class="head">
      <span><span class="nm">{{ s.Quote.Name }}</span> <span class="cd">{{ s.Quote.Code }}</span></span>
      <span class="px">{{ hd.CurrencySymbol }}{{ s.Quote.Price }}</span>
    </div>
    <div class="grid">
      <span class="k">当前市值</span><span class="v">{{ if hd.TotalMarketCapCnyYi }}{{ hd.TotalMarketCapCnyYi | math.round 0 }} 亿{{ else }}<span class="muted">—</span>{{ end }}</span>
      <span class="k">理想买点</span><span class="v">{{ if hd.IdealBuyYi }}{{ hd.IdealBuyYi | math.round 0 }} 亿{{ else }}<span class="muted">—</span>{{ end }}</span>
      <span class="k">1年内卖点</span><span class="v">{{ if hd.SellYi }}{{ hd.SellYi | math.round 0 }} 亿{{ else }}<span class="muted">—</span>{{ end }}</span>
      <span class="k">年内涨幅</span><span class="v {{ if hd.YtdReturnPercent > 0 }}up{{ else if hd.YtdReturnPercent < 0 }}down{{ end }}">{{ if hd.YtdReturnPercent }}{{ hd.YtdReturnPercent | math.round 2 }}%{{ else }}<span class="muted">—</span>{{ end }}</span>
      {{~ if hd.IsHolding ~}}
      <span class="k">持股份数</span><span class="v">{{ hd.Shares }}</span>
      <span class="k">成本价</span><span class="v">{{ hd.CurrencySymbol }}{{ hd.CostPrice }}</span>
      <span class="k">持仓市值</span><span class="v">¥{{ hd.HoldingValueCny | math.round 0 | math.format "N0" }}</span>
      <span class="k">持股比例</span><span class="v">{{ if hd.HoldingRatioPercent }}{{ hd.HoldingRatioPercent | math.round 1 }}%{{ else }}<span class="muted">—</span>{{ end }}</span>
      {{~ end ~}}
    </div>
    {{~ if hd.CanBuy || hd.ShouldSell ~}}
    <div class="badges">
      {{~ if hd.CanBuy ~}}<span class="badge buy">🔴 可以击球</span>{{~ end ~}}
      {{~ if hd.ShouldSell ~}}<span class="badge sell">可考虑卖出</span>{{~ end ~}}
    </div>
    {{~ end ~}}
    {{~ if s.Financials && s.Financials.Snapshot ~}}
    {{~ fs = s.Financials.Snapshot ~}}
    <div class="fin">📊 {{ fs.PeriodLabel }}：营收 {{ fs.RevenueInYi | math.round 1 }} 亿{{ if fs.RevenueYoY }}（同比 {{ fs.RevenueYoY | math.round 1 }}%）{{ end }}，净利 {{ fs.NetProfitInYi | math.round 1 }} 亿{{ if fs.NetProfitYoY }}（同比 {{ fs.NetProfitYoY | math.round 1 }}%）{{ end }}</div>
    {{~ end ~}}
    {{~ if s.Announcements.size > 0 ~}}
    <ul class="ann">
      {{~ for a in s.Announcements ~}}
      <li><span class="ann-date">{{ a.DateText }}</span> <span class="tag">{{ a.Type }}</span> <a href="{{ a.Url }}">{{ a.Title }}</a></li>
      {{~ end ~}}
    </ul>
    {{~ end ~}}
  </div>
  {{~ end ~}}
  {{~ if !group_has_ann ~}}
  <p class="ann-none">本周无新增重要公告</p>
  {{~ end ~}}
  {{~ end ~}}

  {{~ if AiSummary ~}}
  <h2>AI 摘要</h2>
  <p>{{ AiSummary }}</p>
  {{~ end ~}}

  <div class="foot">
    汇率 1 HKD = {{ HkdToCny | math.round 4 }} CNY（{{ if IsLiveRate }}实时{{ else }}回退静态{{ end }}）；港股市值/持仓/买卖点均按此折算为人民币，每股价格保留原币种。<br>
    本报告由规则自动生成，仅供个人跟踪参考，不构成任何投资建议。
  </div>
</body>
</html>
