<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>股票追踪报告 {{ DateText }}</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif; margin: 0; padding: 1.5rem; line-height: 1.5; color: #1a1a1a; background: #fafafa; }
  h1 { font-size: 1.5rem; margin: 0 0 0.25rem; }
  h2 { font-size: 1.15rem; margin: 1.5rem 0 0.5rem; border-left: 4px solid #888; padding-left: 0.5rem; }
  .meta { color: #666; font-size: 0.85rem; margin-bottom: 1rem; }
  .cards { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .card { background: #fff; border: 1px solid #e5e5e5; border-radius: 8px; padding: 0.75rem 1rem; min-width: 8rem; }
  .card .label { color: #666; font-size: 0.8rem; }
  .card .value { font-size: 1.3rem; font-weight: 600; }
  .alerts { background: #fff8f0; border: 1px solid #f0c088; border-radius: 8px; padding: 0.5rem 1rem; }
  .alerts li { margin: 0.25rem 0; }
  .risk { background: #fff0f0; border-color: #e8a0a0; }
  .tag { display: inline-block; background: #eee; color: #444; border-radius: 4px; padding: 0 0.4rem; font-size: 0.75rem; }
  .ann-stock { font-size: 1rem; margin: 0.75rem 0 0.25rem; }
  .ann-list { margin: 0; padding-left: 1.2rem; }
  .ann-list li { margin: 0.15rem 0; font-size: 0.9rem; }
  .ann-date { color: #888; font-variant-numeric: tabular-nums; }
  .forecast { background: #f0f6ff; border-left: 3px solid #6aa; border-radius: 4px; padding: 0.5rem 0.75rem; font-size: 0.9rem; }
  a { color: #2a6; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; background: #fff; font-size: 0.9rem; }
  th, td { border: 1px solid #e5e5e5; padding: 0.4rem 0.6rem; text-align: right; white-space: nowrap; }
  th { background: #f0f0f0; text-align: center; }
  td.name, td.code { text-align: left; }
  .up { color: #c0392b; }      /* 涨：红 */
  .down { color: #27ae60; }    /* 跌：绿 */
  .muted { color: #aaa; }
  .foot { color: #888; font-size: 0.8rem; margin-top: 1.5rem; }
  @media (prefers-color-scheme: dark) {
    body { color: #e5e5e5; background: #1a1a1a; }
    .card, table, .alerts { background: #242424; border-color: #3a3a3a; }
    .risk { background: #2e2020; border-color: #6a3a3a; }
    .tag { background: #333; color: #ccc; }
    .forecast { background: #1e2733; border-left-color: #488; }
    th { background: #2e2e2e; }
    .up { color: #ff6b6b; } .down { color: #51cf66; }
    a { color: #6c9; }
  }
</style>
</head>
<body>
  <h1>股票追踪报告</h1>
  <div class="meta">{{ DateText }} · 收盘后自动生成</div>

  <h2>组合概览</h2>
  <div class="cards">
    <div class="card"><div class="label">上涨</div><div class="value up">{{ Summary.Advancers }}</div></div>
    <div class="card"><div class="label">下跌</div><div class="value down">{{ Summary.Decliners }}</div></div>
    <div class="card"><div class="label">平盘</div><div class="value muted">{{ Summary.Unchanged }}</div></div>
    <div class="card"><div class="label">平均涨跌幅</div><div class="value {{ if Summary.AverageChangePercent > 0 }}up{{ else if Summary.AverageChangePercent < 0 }}down{{ end }}">{{ Summary.AverageChangePercent | math.round 2 }}%</div></div>
  </div>

  {{~ if RiskHits.size > 0 ~}}
  <h2>🚨 风险提示</h2>
  <ul class="alerts risk">
    {{~ for h in RiskHits ~}}
    <li><span class="tag">{{ h.MatchedKeyword }}</span> <strong>{{ h.StockName }}</strong>（{{ h.Code }}）：<a href="{{ h.Announcement.Url }}">{{ h.Announcement.Title }}</a></li>
    {{~ end ~}}
  </ul>
  {{~ end ~}}

  {{~ alerted = Alerted ~}}
  {{~ if alerted.size > 0 ~}}
  <h2>⚠ 异动提醒</h2>
  <ul class="alerts">
    {{~ for s in alerted ~}}
    <li><strong>{{ s.Quote.Name }}</strong>（{{ s.Quote.Code }}）：{{~ for a in s.Alerts ~}} {{ a.Description }}{{ if !for.last }}；{{ end }}{{~ end ~}}</li>
    {{~ end ~}}
  </ul>
  {{~ end ~}}

  <h2>个股明细</h2>
  <div class="table-wrap">
  <table>
    <thead>
      <tr><th>代码</th><th>名称</th><th>现价</th><th>涨跌幅</th><th>量比</th><th>换手率</th><th>MA5</th><th>MA20</th><th>MA60</th><th>近5日</th><th>近20日</th><th>主力净流入(亿)</th></tr>
    </thead>
    <tbody>
      {{~ for s in Stocks ~}}
      {{~ cls = "" ~}}
      {{~ if s.Quote.ChangePercent > 0 ~}}{{~ cls = "up" ~}}{{~ else if s.Quote.ChangePercent < 0 ~}}{{~ cls = "down" ~}}{{~ end ~}}
      <tr>
        <td class="code">{{ s.Quote.Code }}</td>
        <td class="name">{{ s.Quote.Name }}</td>
        <td>{{ s.Quote.Price }}</td>
        <td class="{{ cls }}">{{ s.Quote.ChangePercent }}%</td>
        <td>{{ s.Quote.VolumeRatio }}</td>
        <td>{{ s.Quote.TurnoverRate }}%</td>
        <td>{{ if s.Ma5 }}{{ s.Ma5 | math.round 2 }}{{ else }}<span class="muted">—</span>{{ end }}</td>
        <td>{{ if s.Ma20 }}{{ s.Ma20 | math.round 2 }}{{ else }}<span class="muted">—</span>{{ end }}</td>
        <td>{{ if s.Ma60 }}{{ s.Ma60 | math.round 2 }}{{ else }}<span class="muted">—</span>{{ end }}</td>
        <td class="{{ if s.Return5 > 0 }}up{{ else if s.Return5 < 0 }}down{{ end }}">{{ if s.Return5 }}{{ s.Return5 | math.round 2 }}%{{ else }}<span class="muted">—</span>{{ end }}</td>
        <td class="{{ if s.Return20 > 0 }}up{{ else if s.Return20 < 0 }}down{{ end }}">{{ if s.Return20 }}{{ s.Return20 | math.round 2 }}%{{ else }}<span class="muted">—</span>{{ end }}</td>
        <td class="{{ if s.FundFlow && s.FundFlow.MainNetInflow > 0 }}up{{ else if s.FundFlow && s.FundFlow.MainNetInflow < 0 }}down{{ end }}">{{ if s.FundFlow }}{{ s.FundFlow.MainNetInflowInYi | math.round 2 }}{{ else }}<span class="muted">—</span>{{ end }}</td>
      </tr>
      {{~ end ~}}
    </tbody>
  </table>
  </div>

  {{~ has_fin = false ~}}
  {{~ for s in Stocks ~}}{{~ if s.Financials && s.Financials.Snapshot ~}}{{~ has_fin = true ~}}{{~ end ~}}{{~ end ~}}
  {{~ if has_fin ~}}
  <h2>财报速览</h2>
  <div class="table-wrap">
  <table>
    <thead>
      <tr><th>代码</th><th>名称</th><th>报告期</th><th>营收(亿)</th><th>营收同比</th><th>净利(亿)</th><th>净利同比</th><th>ROE</th><th>毛利率</th></tr>
    </thead>
    <tbody>
      {{~ for s in Stocks ~}}
      {{~ if s.Financials && s.Financials.Snapshot ~}}
      {{~ fs = s.Financials.Snapshot ~}}
      <tr>
        <td class="code">{{ s.Quote.Code }}</td>
        <td class="name">{{ s.Quote.Name }}</td>
        <td class="name">{{ fs.PeriodLabel }}</td>
        <td>{{ fs.RevenueInYi | math.round 2 }}</td>
        <td class="{{ if fs.RevenueYoY > 0 }}up{{ else if fs.RevenueYoY < 0 }}down{{ end }}">{{ if fs.RevenueYoY }}{{ fs.RevenueYoY | math.round 2 }}%{{ else }}<span class="muted">—</span>{{ end }}</td>
        <td>{{ fs.NetProfitInYi | math.round 2 }}</td>
        <td class="{{ if fs.NetProfitYoY > 0 }}up{{ else if fs.NetProfitYoY < 0 }}down{{ end }}">{{ if fs.NetProfitYoY }}{{ fs.NetProfitYoY | math.round 2 }}%{{ else }}<span class="muted">—</span>{{ end }}</td>
        <td>{{ if fs.Roe }}{{ fs.Roe | math.round 2 }}%{{ else }}<span class="muted">—</span>{{ end }}</td>
        <td>{{ if fs.GrossMargin }}{{ fs.GrossMargin | math.round 2 }}%{{ else }}<span class="muted">—</span>{{ end }}</td>
      </tr>
      {{~ end ~}}
      {{~ end ~}}
    </tbody>
  </table>
  </div>
  {{~ for s in Stocks ~}}
  {{~ if s.Financials && s.Financials.Forecast ~}}
  {{~ fc = s.Financials.Forecast ~}}
  <p class="forecast">📊 <strong>{{ s.Quote.Name }} 业绩预告</strong>（{{ fc.Type }} · {{ fc.NoticeDateText }}）：{{ fc.Content }}</p>
  {{~ end ~}}
  {{~ end ~}}
  {{~ end ~}}

  {{~ has_ann = false ~}}
  {{~ for s in Stocks ~}}{{~ if s.Announcements.size > 0 ~}}{{~ has_ann = true ~}}{{~ end ~}}{{~ end ~}}
  {{~ if has_ann ~}}
  <h2>近期公告</h2>
  {{~ for s in Stocks ~}}
  {{~ if s.Announcements.size > 0 ~}}
  <h3 class="ann-stock">{{ s.Quote.Name }}（{{ s.Quote.Code }}）</h3>
  <ul class="ann-list">
    {{~ for a in s.Announcements ~}}
    <li><span class="ann-date">{{ a.DateText }}</span> <span class="tag">{{ a.Type }}</span> <a href="{{ a.Url }}">{{ a.Title }}</a></li>
    {{~ end ~}}
  </ul>
  {{~ end ~}}
  {{~ end ~}}
  {{~ end ~}}

  {{~ if AiSummary ~}}
  <h2>AI 摘要</h2>
  <p>{{ AiSummary }}</p>
  {{~ end ~}}

  <div class="foot">本报告由规则自动生成，仅供个人跟踪参考，不构成任何投资建议。</div>
</body>
</html>
