{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Agent": {
    "Stocks": [
      { "Code": "600519.SH", "Group": "核心持仓" },
      { "Code": "00700.HK", "Group": "观察池" }
    ],
    "Alerts": {
      "PctChangeThreshold": 5.0,
      "VolumeRatioThreshold": 2.0
    },
    "Report": {
      "OutputDirectory": "reports",
      "Formats": [ "Html", "Markdown" ],
      "KlineLookbackDays": 70
    }
  }
}
